#!/bin/bash
# systemd-tmpfiles doesn't support skipping writing to files that already exist
# - copy the docker group to /etc because docker reads /etc/group directly
# - copy the sudo and wheel groups to /etc so that new uses can be added to them
# - copy the core and root users to /etc so the passwd utility works correctly

# Inherit root from environment or command line
ROOT="${1:-$ROOT}"
BASE="${2:-${ROOT}/usr/share/baselayout}"

# Users/Groups to copy so they can be modified (systemd-journal is also needed for systemd-tmpfiles)
COPY_USERS="root|core"
COPY_GROUPS="root|core|docker|sudo|wheel|systemd-journal"

# New function to update an etc file if new entries are found
# Pipeline stages:
# 1. grep -E filters lines from the reference file (located at ${BASE}/${file}) matching the specified pattern.
# 2. The output is piped to grep -v -x -f, which uses process substitution to generate exclusion patterns
#    based on the first field of the corresponding file in ${ROOT}/etc. This removes any entries already present.
# 3. If the resulting new_entries variable is non-empty, these entries are appended to the target file.
update_file() {
    local file="$1"
    local pattern="$2"
    local new_entries
    new_entries=$(grep -E -e "^(${pattern}):" "${BASE}/${file}" | grep -v -x -f <( [ -f "${ROOT}/etc/${file}" ] && cut -s -d ":" -f 1 "${ROOT}/etc/${file}" | sed 's/^/\^/' | sed 's/$/:.*$/' ))
    if [ -n "$new_entries" ]; then
        echo "$new_entries" >> "${ROOT}/etc/${file}"
    fi
}

mkdir -p "${ROOT}/etc"

# readable files
umask 022
update_file "passwd" "${COPY_USERS}"
update_file "group" "${COPY_GROUPS}"

# secure files
umask 027
update_file "shadow" "${COPY_USERS}"
update_file "gshadow" "${COPY_GROUPS}"

# The script runs without set -euo pipefail and allows grep to return 1, thus the last statement must not be grep
# because it would propagate the exit code 1 and let the systemd unit fail.
exit 0
